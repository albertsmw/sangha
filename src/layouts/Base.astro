---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { defaultLang, ui, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  image?: string;
}

const {
  lang = defaultLang,
  title,
  description,
  image = '/og-default.png',
} = Astro.props;

const t = useTranslations(lang);
const siteName = t('site.name');
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const desc = description ?? t('site.description');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{fullTitle}</title>
    <meta name="description" content={desc} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'pl' ? 'pl_PL' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    {Object.keys(ui).map((l) => (
      <link
        rel="alternate"
        hreflang={l}
        href={new URL(
          Astro.url.pathname.replace(/^\/(en|pl)/, `/${l}`),
          Astro.site
        )}
      />
    ))}
  </head>
  <body class="bg-stone-50 text-stone-800 font-sans antialiased min-h-screen flex flex-col">
    <Nav lang={lang} />
    <main class="flex-1 mx-auto max-w-5xl w-full px-6 py-10">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
