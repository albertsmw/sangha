---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-stone-200 mt-24">
  <div class="mx-auto max-w-5xl px-6 py-8 text-sm text-stone-500 flex flex-wrap justify-between gap-4">
    <p>&copy; {year} {t('site.name')}</p>
    <p>
      <a href={`/${lang}/contact`} class="hover:text-stone-900">{t('footer.contact')}</a>
    </p>
  </div>
</footer>
