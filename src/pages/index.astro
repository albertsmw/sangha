---
import { defaultLang, languages } from '../i18n/ui';
const supported = Object.keys(languages);
---

<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sangha</title>
    <meta http-equiv="refresh" content={`0; url=/${defaultLang}/`} />
    <link rel="canonical" href={`/${defaultLang}/`} />
    <script is:inline define:vars={{ supported, defaultLang }}>
      try {
        const stored = localStorage.getItem('lang');
        let pick = stored && supported.includes(stored) ? stored : null;
        if (!pick) {
          const prefs = navigator.languages?.length ? navigator.languages : [navigator.language];
          for (const pref of prefs) {
            const short = String(pref || '').toLowerCase().split('-')[0];
            if (supported.includes(short)) { pick = short; break; }
          }
        }
        window.location.replace('/' + (pick || defaultLang) + '/');
      } catch {
        window.location.replace('/' + defaultLang + '/');
      }
    </script>
  </head>
  <body>
    <p style="font-family: system-ui, sans-serif; padding: 2rem; color: #555;">
      Redirecting… <a href={`/${defaultLang}/`}>continue</a>
    </p>
  </body>
</html>
