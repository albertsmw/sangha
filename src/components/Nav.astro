---
const links = [
  { href: '/', label: 'Home' },
  { href: '/lama-dorje', label: 'Lama Dorje' },
  { href: '/sangha', label: 'Sangha' },
  { href: '/news', label: 'News' },
  { href: '/events', label: 'Events' },
  { href: '/contact', label: 'Contact' },
];

const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<nav class="border-b border-stone-200 bg-white/80 backdrop-blur sticky top-0 z-10">
  <div class="mx-auto max-w-5xl px-6 py-4 flex items-center justify-between flex-wrap gap-4">
    <a href="/" class="font-serif text-xl tracking-wide text-stone-900">Sangha</a>
    <ul class="flex gap-6 text-sm">
      {links.slice(1).map(({ href, label }) => (
        <li>
          <a
            href={href}
            class={`hover:text-stone-900 transition-colors ${
              isActive(href) ? 'text-stone-900 font-medium' : 'text-stone-600'
            }`}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>
