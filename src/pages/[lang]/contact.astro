---
import Base from '../../layouts/Base.astro';
import { languages, useTranslations, type Lang } from '../../i18n/ui';
import { isLang } from '../../i18n/utils';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!isLang(lang!)) throw new Error(`Unknown lang: ${lang}`);
const t = useTranslations(lang);

const whatsappUrl = '#';
---

<Base lang={lang} title={t('contact.title')}>
  <div class="max-w-2xl mx-auto">
    <h1 class="font-serif text-4xl text-stone-900">{t('contact.title')}</h1>
    <p class="mt-4 text-stone-600">{t('contact.intro')}</p>

    <div class="mt-10 rounded-lg border border-stone-200 p-6">
      <h2 class="font-serif text-xl text-stone-900">{t('contact.whatsapp')}</h2>
      <p class="mt-4">
        <a
          href={whatsappUrl}
          class="inline-block rounded-md bg-stone-900 px-4 py-2 text-sm text-white hover:bg-stone-700"
        >
          {t('contact.whatsappCta')}
        </a>
      </p>
    </div>

    <p class="mt-6 text-sm text-stone-500">{t('contact.moreSoon')}</p>
  </div>
</Base>
