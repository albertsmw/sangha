---
import { useTranslations, type Lang } from '../i18n/ui';
import { localeDate } from '../i18n/utils';

interface Props {
  lang: Lang;
  href: string;
  title: string;
  date: Date;
  location?: string;
  summary: string;
  image?: string;
  imageAlt?: string;
}

const { lang, href, title, date, location, summary, image, imageAlt } = Astro.props;
const t = useTranslations(lang);
---

<a
  href={href}
  class="group block overflow-hidden rounded-2xl border border-amber-200 bg-gradient-to-br from-amber-50 via-stone-50 to-white shadow-sm hover:shadow-md transition-shadow"
>
  <div class="grid md:grid-cols-2 gap-0">
    {image && (
      <div class="aspect-[4/3] md:aspect-auto overflow-hidden bg-stone-100">
        <img
          src={image}
          alt={imageAlt ?? ''}
          class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform"
        />
      </div>
    )}
    <div class={`p-8 flex flex-col justify-center ${image ? '' : 'md:col-span-2'}`}>
      <span class="inline-flex items-center self-start gap-1.5 rounded-full bg-amber-100 text-amber-900 text-xs font-medium uppercase tracking-wider px-3 py-1">
        <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.37 2.448a1 1 0 00-.364 1.118l1.287 3.957c.3.922-.755 1.688-1.54 1.118l-3.37-2.447a1 1 0 00-1.175 0l-3.37 2.447c-.784.57-1.838-.196-1.539-1.118l1.287-3.957a1 1 0 00-.364-1.118L2.05 9.384c-.783-.57-.38-1.81.588-1.81h4.163a1 1 0 00.95-.69l1.286-3.957z" />
        </svg>
        {t('home.highlightBadge')}
      </span>
      <p class="mt-4 text-sm text-stone-500">
        {localeDate(date, lang)}{location && <> · {location}</>}
      </p>
      <h3 class="mt-1 font-serif text-2xl md:text-3xl text-stone-900 group-hover:underline">
        {title}
      </h3>
      <p class="mt-3 text-stone-700">{summary}</p>
      <p class="mt-4 text-sm text-amber-800 font-medium">{t('home.learnMore')}</p>
    </div>
  </div>
</a>
