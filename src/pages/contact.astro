---
import Base from '../layouts/Base.astro';
---

<Base title="Contact" description="Get in touch with the sangha.">
  <h1 class="font-serif text-4xl text-stone-900">Contact</h1>
  <p class="mt-4 text-stone-600 max-w-xl">
    Reach out by email or visit us at our meeting place.
  </p>

  <div class="grid md:grid-cols-2 gap-12 mt-10">
    <div>
      <h2 class="font-serif text-xl text-stone-900">By email</h2>
      <p class="text-stone-700 mt-1">
        <a href="mailto:hello@example.com" class="underline">hello@example.com</a>
      </p>
    </div>

    <div>
      <h2 class="font-serif text-xl text-stone-900">Where we meet</h2>
      <p class="text-stone-700 mt-1">
        [Address line 1]<br />
        [City, postcode]
      </p>
    </div>
  </div>
</Base>
