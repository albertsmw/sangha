---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { languages, type Lang } from '../../i18n/ui';
import { isLang } from '../../i18n/utils';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!isLang(lang!)) throw new Error(`Unknown lang: ${lang}`);

const entry = await getEntry('pages', `${lang}/lama-dorje`);
if (!entry) throw new Error(`Missing pages/${lang}/lama-dorje.md`);
const { Content } = await render(entry);
---

<Base lang={lang} title={entry.data.title} description={entry.data.intro}>
  {entry.data.quote && (
    <section class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
      {entry.data.image && (
        <div class="aspect-square overflow-hidden">
          <img
            src={entry.data.image}
            alt={entry.data.imageAlt ?? ''}
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      )}
      <figure class="relative px-6 md:px-10">
        <span aria-hidden="true" class="font-serif text-6xl leading-none text-orange-500 block">&ldquo;</span>
        <blockquote class="font-serif text-2xl md:text-3xl text-stone-900 leading-snug mt-2">
          {entry.data.quote}
        </blockquote>
        <span aria-hidden="true" class="font-serif text-6xl leading-none text-orange-500 block text-right">&rdquo;</span>
        {entry.data.quoteAuthor && (
          <figcaption class="mt-6 font-serif text-lg text-orange-500">{entry.data.quoteAuthor}</figcaption>
        )}
      </figure>
    </section>
  )}

  <article class="max-w-3xl mx-auto mt-16">
    <h1 class="font-serif text-4xl text-stone-900">{entry.data.title}</h1>
    {entry.data.intro && (
      <p class="text-lg text-stone-600 mt-4">{entry.data.intro}</p>
    )}
    <div class="prose prose-stone mt-8 max-w-none">
      <Content />
    </div>
  </article>
</Base>
