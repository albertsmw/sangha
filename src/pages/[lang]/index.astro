---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import HighlightedItem from '../../components/HighlightedItem.astro';
import { languages, useTranslations, type Lang } from '../../i18n/ui';
import { localeDate, isLang } from '../../i18n/utils';
import { assertParity, splitEntryId } from '../../i18n/parity';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!isLang(lang!)) throw new Error(`Unknown lang: ${lang}`);
const t = useTranslations(lang);

const allNews = await getCollection('news');
assertParity(allNews, 'news', { matchFields: ['type', 'date', 'highlight'] });

const now = new Date();

const langNews = allNews.filter((n) => splitEntryId(n.id)?.lang === lang);

const highlighted = langNews
  .filter((n) => n.data.highlight && (n.data.type !== 'event' || n.data.date >= now))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const latestNews = langNews
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const slugOf = (id: string) => splitEntryId(id)?.slug ?? id;
---

<Base lang={lang} title={t('site.name')}>
  <section class="text-center py-12">
    <h1 class="font-serif text-4xl md:text-5xl text-stone-900">{t('home.title')}</h1>
    <p class="mt-4 text-lg text-stone-600 max-w-xl mx-auto">{t('home.intro')}</p>
  </section>

  {highlighted.length > 0 && (
    <section class="mt-4 space-y-6">
      {highlighted.map((item) => (
        <HighlightedItem
          lang={lang}
          href={`/${lang}/news/${slugOf(item.id)}`}
          title={item.data.title}
          date={item.data.date}
          location={item.data.location}
          summary={item.data.summary}
          image={item.data.image}
          imageAlt={item.data.imageAlt}
        />
      ))}
    </section>
  )}

  <section class="mt-16">
    <div class="flex items-baseline justify-between">
      <h2 class="font-serif text-2xl text-stone-900">{t('home.latestNews')}</h2>
      <a href={`/${lang}/news`} class="text-sm text-stone-600 hover:text-stone-900">
        {t('home.allNews')}
      </a>
    </div>
    <ul class="mt-6 grid md:grid-cols-3 gap-8">
      {latestNews.length === 0 && (
        <li class="text-stone-500">{t('home.noNews')}</li>
      )}
      {latestNews.map((item) => (
        <li>
          <a href={`/${lang}/news/${slugOf(item.id)}`} class="block group">
            {item.data.image && (
              <div class="aspect-[16/10] overflow-hidden rounded-md bg-stone-100 mb-3">
                <img
                  src={item.data.image}
                  alt={item.data.imageAlt ?? ''}
                  class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform"
                />
              </div>
            )}
            <p class="text-xs text-stone-500 flex items-center gap-2">
              {item.data.type === 'event' && (
                <span class="inline-block rounded-full bg-stone-900 text-white text-[10px] uppercase tracking-wider px-2 py-0.5">
                  {t('news.eventBadge')}
                </span>
              )}
              <span>{localeDate(item.data.date, lang)}</span>
            </p>
            <p class="font-serif text-lg text-stone-900 mt-1 group-hover:underline">
              {item.data.title}
            </p>
            <p class="text-sm text-stone-600 mt-2">{item.data.summary}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
