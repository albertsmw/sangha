---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { useTranslations } from '../../../i18n/ui';
import { localeDate, isLang } from '../../../i18n/utils';
import { assertParity, splitEntryId } from '../../../i18n/parity';

export async function getStaticPaths() {
  const all = await getCollection('news');
  assertParity(all, 'news');
  return all.map((entry) => {
    const parts = splitEntryId(entry.id)!;
    return {
      params: { lang: parts.lang, slug: parts.slug },
      props: { entry },
    };
  });
}

const { lang } = Astro.params;
if (!isLang(lang!)) throw new Error(`Unknown lang: ${lang}`);
const t = useTranslations(lang);

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base
  lang={lang}
  title={entry.data.title}
  description={entry.data.summary}
  image={entry.data.image}
>
  <article class="max-w-3xl mx-auto">
    <p class="text-sm text-stone-500">{localeDate(entry.data.date, lang)}</p>
    <h1 class="font-serif text-4xl text-stone-900 mt-2">{entry.data.title}</h1>
    {entry.data.image && (
      <img
        src={entry.data.image}
        alt={entry.data.imageAlt ?? ''}
        class="mt-6 w-full rounded-md"
      />
    )}
    <div class="prose prose-stone mt-8 max-w-none">
      <Content />
    </div>
    <p class="mt-12">
      <a href={`/${lang}/news`} class="text-sm text-stone-600 hover:text-stone-900">
        {t('news.back')}
      </a>
    </p>
  </article>
</Base>
