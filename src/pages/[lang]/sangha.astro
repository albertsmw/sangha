---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { languages, type Lang } from '../../i18n/ui';
import { isLang } from '../../i18n/utils';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!isLang(lang!)) throw new Error(`Unknown lang: ${lang}`);

const entry = await getEntry('pages', `${lang}/sangha`);
if (!entry) throw new Error(`Missing pages/${lang}/sangha.md`);
const { Content } = await render(entry);
---

<Base lang={lang} title={entry.data.title} description={entry.data.intro}>
  <article class="prose prose-stone max-w-none">
    <h1 class="font-serif text-4xl text-stone-900">{entry.data.title}</h1>
    {entry.data.intro && (
      <p class="text-lg text-stone-600 mt-4">{entry.data.intro}</p>
    )}
    <div class="mt-8">
      <Content />
    </div>
  </article>
</Base>
